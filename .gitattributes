# Scripts de shell precisam de LF mesmo quando o repositório é clonado no
# Windows: com CRLF o kernel falha com "bad interpreter: /usr/bin/env bash^M".
*.sh            text eol=lf
docker-entrypoint.sh text eol=lf

# Demais arquivos de texto normalizados para LF no repositório.
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.tex           text eol=lf
Dockerfile*     text eol=lf

# Binários: nunca normalizar.
*.xlsx          binary
*.safetensors   binary
*.pt            binary
*.pth           binary
*.bin           binary
*.pdf           binary
*.png           binary
